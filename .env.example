# ──────────────────────────────────────────────────────────────────────────
# Sri Chendurar Catering – environment variables
# Copy to .env.local for local development (git-ignored).
# In production set these in the hosting dashboard (Cloudflare Pages →
# Settings → Variables and Secrets → Production), then redeploy.
# All NEXT_PUBLIC_* values are PUBLIC by design (they are sent to the browser);
# the data is protected by database Row Level Security. Never put a secret
# key here – the production build refuses secret/service_role keys.
# ──────────────────────────────────────────────────────────────────────────

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase → Project Settings → API Keys → "Publishable key" (starts with sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Older name, still accepted as a fallback (legacy anon key – being retired by Supabase).
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local development / testing only: run without Supabase, data stays in this browser.
# A production build without the two values above fails unless this is set to 1.
# NEXT_PUBLIC_DEMO_MODE=1
